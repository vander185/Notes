<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:id="@+id/w_body" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Claire" android:textColor="#9fd4ff" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_txt" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Touche pour parler à Claire" android:textColor="#ffffff" android:textSize="14sp"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_mic" android:layout_width="52dp" android:layout_height="52dp"
        android:src="@drawable/ic_mic" android:background="@drawable/widget_mic" android:padding="13dp"
        android:contentDescription="Parler à Claire" />
</LinearLayout>
